---
/**
 * index.astro — bits.wickedagile.com: the title, one line, and the list of bits
 * (src/data/bits.js). Each bit is served as-is from its folder under public/.
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import { BITS } from '../data/bits.js';

const REPO = 'https://github.com/mikeparcewski/wicked-bits';
// the site's base ('/wicked-bits/' on the Pages project URL, '/' on a custom domain), ending in '/'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base
  title="wicked bits: interactive pieces and media from Wicked Agile"
  description="Interactive pieces and media from Wicked Agile, one bit at a time."
  favicon={`${base}favicon.svg`}
>
  <!-- the family path "Wicked Agile / labs / wicked-bits"; the last crumb is this site's home -->
  <Topbar pkg="wicked-bits" repo={REPO} />
  <main class="wrap bits">
    <h1 class="bits-title">wicked bits</h1>
    <p class="bits-intro">Interactive pieces and media from Wicked Agile, one bit at a time.</p>
    <ul class="bits-list">
      {BITS.map((b) => (
        <li>
          <a class="bit" href={`${base}${b.slug}/`}>
            <span class="bit-kind">{b.kind}</span>
            <span class="bit-title">{b.title}</span>
            <span class="bit-desc">{b.desc}</span>
            <span class="bit-cta">Play it →</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer repo={REPO} />
</Base>

<style>
  .bits { position: relative; padding-top: calc(var(--topbar-h) + 72px); padding-bottom: 96px; min-height: 70svh; }
  /* The veil (crew's, as an element): the page colour behind the text column, with a soft edge, so the
     background art reads at 40% under any text (0.032 of ink in dark, 0.024 in light, below the 0.04
     line grid this page wore before) and at full strength only around it. It sits above the art
     (z -2) and below wicked-web's glow (body::after, later in the tree), so the glow is unchanged. */
  .bits::before {
    content: ''; position: absolute; z-index: -1; pointer-events: none;
    top: calc(var(--topbar-h) + 72px); bottom: 96px; left: clamp(16px, 4vw, 28px);
    width: min(720px, 100% - 2 * clamp(16px, 4vw, 28px));
    --veil: color-mix(in oklab, var(--canvas) 60%, transparent);
    background: var(--veil); border-radius: 16px; box-shadow: 0 0 32px 32px var(--veil);
  }
  .bits-title { font-size: var(--text-display); font-weight: var(--weight-strong); letter-spacing: var(--tracking-title); line-height: 1.1; color: var(--ink); }
  .bits-intro { margin-top: 14px; font-size: var(--text-lead); color: var(--muted); max-width: 60ch; }
  .bits-list { list-style: none; margin-top: 40px; display: grid; gap: 16px; max-width: 720px; }
  .bit { display: grid; gap: 6px; padding: 22px 24px; border: 1px solid var(--hairline-strong); border-radius: 12px; background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color .22s var(--ease); }
  .bit:hover { border-color: var(--accent); }
  .bit-kind { font-size: var(--text-caption); font-weight: var(--weight-strong); color: var(--muted); }
  .bit-title { font-size: var(--text-section); font-weight: var(--weight-strong); color: var(--ink); }
  .bit-desc { font-size: var(--text-body); color: var(--muted); max-width: 64ch; }
  .bit-cta { margin-top: 8px; font-size: var(--text-body); font-weight: var(--weight-strong); color: var(--ink); }
  .bit:hover .bit-cta { color: var(--accent); }
  @media (max-width: 600px) {
    .bits { padding-top: calc(var(--topbar-h) + 40px); padding-bottom: 64px; }
    .bits::before { top: calc(var(--topbar-h) + 40px); bottom: 64px; }
    .bit { padding: 18px; }
  }
</style>

<style is:global>
  /* The family chrome snaps (wicked-web tokens.css: html scroll-snap-type y proximity, in
     @layer base) and the footer is a snap point. This page is barely taller than the viewport,
     so Chrome snapped to the footer at load and hid the title under the header. Bits doesn't
     snap; this unlayered rule wins over the layered one. */
  html { scroll-snap-type: none; }

  /* bits' background art (src/art/bits-bg.svg): media and play, one bit at a time. A film strip, the
     player, a waveform and the play button; ones and zeros, the factory belt of The Work, a controller
     and headphones; a clapperboard, an edit timeline, the pointer and a film reel, wired by dashed
     connectors. The product sites' engine and register: ONE fixed layer painted in --ink through its
     line-art mask (stroke 1.4, outlines 1.8), centred and cover-sized, at 0.08 (0.06 in light), so it
     recolours with the theme. It replaces wicked-web's line grid on this layer; it never moves, under
     any motion setting. The mask is a file Vite resolves (base-aware, same origin). Only where the veils
     below can be drawn (color-mix) and the mask works: an older browser keeps wicked-web's layer rather
     than getting the art without its veil, or the ink as a solid block. */
  @supports (color: color-mix(in oklab, red 50%, blue)) and ((mask: none) or (-webkit-mask: none)) {
    body::before {
      content: ''; position: fixed; inset: 0; z-index: -2; pointer-events: none;
      background-color: var(--ink); background-image: none;
      opacity: 0.08;
      -webkit-mask: url('../art/bits-bg.svg') center / cover no-repeat;
              mask: url('../art/bits-bg.svg') center / cover no-repeat;
    }
    [data-theme="light"] body::before { opacity: 0.06; }
  }
  /* The family footer (wicked-web) is 92% page colour over a blur of what is behind it, so the art at
     full strength would tint it a level more than the old grid did. A stronger veil (85%) inside the
     footer's own stacking context (its backdrop-filter makes one): above its background, below its text. */
  html body .footer { position: relative; }
  html body .footer::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: color-mix(in oklab, var(--canvas) 85%, transparent);
  }
</style>
