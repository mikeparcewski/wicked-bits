---
/**
 * index.astro — bits.wickedagile.com: the title, one line, and the list of bits
 * (src/data/bits.js). Each bit is served as-is from its folder under public/.
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import { BITS } from '../data/bits.js';

const REPO = 'https://github.com/mikeparcewski/wicked-bits';
// the site's base ('/wicked-bits/' on the Pages project URL, '/' on a custom domain), ending in '/'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base
  title="wicked bits: interactive pieces and media from Wicked Agile"
  description="Interactive pieces and media from Wicked Agile, one bit at a time."
  favicon={`${base}favicon.svg`}
>
  <Topbar pkg="bits" repo={REPO} />
  <main class="wrap bits">
    <h1 class="bits-title">wicked bits</h1>
    <p class="bits-intro">Interactive pieces and media from Wicked Agile, one bit at a time.</p>
    <ul class="bits-list">
      {BITS.map((b) => (
        <li>
          <a class="bit" href={`${base}${b.slug}/`}>
            <span class="bit-kind">{b.kind}</span>
            <span class="bit-title">{b.title}</span>
            <span class="bit-desc">{b.desc}</span>
            <span class="bit-cta">Play it →</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer repo={REPO} />
</Base>

<style>
  .bits { padding-top: calc(var(--topbar-h) + 72px); padding-bottom: 96px; min-height: 70svh; }
  .bits-title { font-size: var(--text-display); font-weight: var(--weight-strong); letter-spacing: var(--tracking-title); line-height: 1.1; color: var(--ink); }
  .bits-intro { margin-top: 14px; font-size: var(--text-lead); color: var(--muted); max-width: 60ch; }
  .bits-list { list-style: none; margin-top: 40px; display: grid; gap: 16px; max-width: 720px; }
  .bit { display: grid; gap: 6px; padding: 22px 24px; border: 1px solid var(--hairline-strong); border-radius: 12px; background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color .22s var(--ease); }
  .bit:hover { border-color: var(--accent); }
  .bit-kind { font-size: var(--text-caption); font-weight: var(--weight-strong); color: var(--muted); }
  .bit-title { font-size: var(--text-section); font-weight: var(--weight-strong); color: var(--ink); }
  .bit-desc { font-size: var(--text-body); color: var(--muted); max-width: 64ch; }
  .bit-cta { margin-top: 8px; font-size: var(--text-body); font-weight: var(--weight-strong); color: var(--ink); }
  .bit:hover .bit-cta { color: var(--accent); }
  @media (max-width: 600px) {
    .bits { padding-top: calc(var(--topbar-h) + 40px); padding-bottom: 64px; }
    .bit { padding: 18px; }
  }
</style>

<style is:global>
  /* The family chrome snaps (wicked-web tokens.css: html scroll-snap-type y proximity, in
     @layer base) and the footer is a snap point. This page is barely taller than the viewport,
     so Chrome snapped to the footer at load and hid the title under the header. Bits doesn't
     snap; this unlayered rule wins over the layered one. */
  html { scroll-snap-type: none; }
</style>
